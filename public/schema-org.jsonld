    {
      "@type": "FAQPage",
      "@id": "https://jadwali.ma/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "ما هو متوسط وقت إنجاز استعمال الزمن؟",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "متوسط وقت الإنجاز هو 48 ساعة من استلام جميع المعطيات المطلوبة."
          }
        },
        {
          "@type": "Question",
          "name": "هل يمكن تعديل استعمال الزمن بعد الإنتاج؟",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "نعم، نقدم مواكبة مجانية طوال السنة الدراسية لأي تعديلات طارئة مثل انتقال أستاذ أو تعديل حصص."
          }
        },
        {
          "@type": "Question",
          "name": "ما هي طرق الدفع المتاحة؟",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "نقبل الدفع عبر التحويل البنكي أو عبر وكالات تحويل الأموال مثل وفاكاش وكاش بلوس."
          }
        },
        {
          "@type": "Question",
          "name": "هل تدعمون المؤسسات خارج المغرب؟",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "حالياً نركز على المؤسسات التعليمية المغربية فقط."
          }
        },
        {
          "@type": "Question",
          "name": "هل الأسعار ثابتة أم تختلف حسب المؤسسة؟",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "الأسعار المذكورة تأشيرية وتقريبية. السعر النهائي يتحدد بعد دراسة طلبك وتقييم تعقيد المؤسسة ونسبة الإشغال."
          }
        }
